msgid "  -b, --bcc <address>         Add Bcc: address"
msgstr "  -b, --bcc <adreso>          Aldoni trian adreson"

#: usage.c:266
msgid "  -C, --crypto                Use crypto (signing/encryption)"
msgstr "  -C, --crypto                Subskribi aŭ ĉifri"

#: usage.c:267
msgid "                              Must be set up in the config file"
msgstr "                              Devas esti agordita en la agordodosiero"

#: usage.c:268
msgid "  -c, --cc <address>          Add Cc: address"
msgstr "  -c, --cc <adreso>           Aldoni duan adreson"

#: usage.c:269
msgid "  -E, --edit-message          Edit message (draft/include)"
msgstr "  -E, --edit-message          Redakti mesaĝon (malneto/inkluzivaĵo)"

#: usage.c:270
msgid "                              (supplied by -H or -i)"
msgstr "                              (provizita per -H aŭ -i)"

#: usage.c:271
msgid "  -H, --draft <file>          Use draft email file"
msgstr "  -H, --draft <dosiero>       Uzi malnetan retpoŝtaĵan dosieron"

#: usage.c:272
msgid "                              Full email with headers and body"
msgstr "                              Plena retpoŝtaĵo kun ĉapoj kaj korpo"

#: usage.c:273
msgid "  -i, --include <file>        Include body file"
msgstr "  -i, --include <inkluzivaĵo> Inkluvizigi korpodosieron"

#: usage.c:274
msgid "  -s, --subject <subject>     Set Subject:"
msgstr "  -s, --subject <subject>     Specifi temon"

#: usage.c:275
msgid "  -- <address> [...]          Add To: addresses"
msgstr "  -- <adreso>  [...]          Aldoni alsendotajn adresojn"

#. L10N: Examples: Filenames and email subjects may be translated
#: usage.c:284
msgid "  neomutt flatcap --subject 'Meeting' < meeting.txt"
msgstr "  neomutt flatcap --subject 'Kunveno' < kunveno.txt"

#: usage.c:285
msgid "  neomutt jim@example.com --cc bob@example.com --subject 'Party' --include party.txt"
msgstr "  neomutt jim@example.com --cc bob@example.com --subject 'Festo' --include festo.txt"

