msgstr "ekz-e /etc/neomuttrc kaj ~/.neomuttrc"

#. L10N: Parameters in <>s may be translated
#: usage.c:138
msgid "  -n, --no-system-config      Don't read system config file"
msgstr "  -n, --no-system-config      Ne analizi la sisteman agordodosieron"

#: usage.c:139
msgid "  -F, --config <file>         Use this user config file"
msgstr "  -F, --config <dosiero>      Uzi specifitan agordodosieron"

#: usage.c:140 usage.c:147
msgid "                              May be used multiple times"
msgstr "                              Rajtas esti uzata plurfoje"

#: usage.c:143
msgid "These options override the config:"
msgstr "Tiuj opcioj superregas la agordodosieron:"

#: usage.c:144
msgid "  -m, --mbox-type <type>      Set default mailbox type"
msgstr "  -m, --mbox-type <type>      Agordi la aprioran tipon de leterkestoj"

#: usage.c:145
msgid "                              May be: maildir, mbox, mh, mmdf"
msgstr "                              Eblaj valoroj: maildir, mbox, mh, mmdf"

#: usage.c:146
msgid "  -e, --command <command>     Run extra commands"
msgstr "  -e, --command <komando>     Plenumigi aldonajn komandojn"

#: usage.c:150
msgid "These logging options override the config:"
msgstr "Tiuj protokolaj opcioj superregas la agordodosieron:"

#: usage.c:151
msgid "  -d, --debug-level <level>   Set logging level"
msgstr "  -d, --debug-level <nivelo>  Specifi la protokolan nivelon"

#: usage.c:152
msgid "                              0 (off), 1 (low) .. 5 (high)"
msgstr "                              0 (malŝalta), 1 (malalta) .. 5 (alta)"

#: usage.c:153
msgid "  -l, --debug-file <file>     Set logging file"
msgstr "  -l, --debug-file <dosiero>  Agordi protokolon"

#: usage.c:154
msgid "                              Default file '~/.neomuttdebug0'"
msgstr "                              Apriora dosiero: '~/.neomuttdebug0'"

