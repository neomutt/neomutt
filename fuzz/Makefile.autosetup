FUZZ_OBJS   = fuzz/address.o fuzz/body.o fuzz/cli.o fuzz/date.o fuzz/mbox.o \
	      fuzz/pattern.o

CFLAGS	+= -I$(SRCDIR)/fuzz

FUZZ_ADDRESS = fuzz/address-fuzz$(EXEEXT)
FUZZ_BODY = fuzz/body-fuzz$(EXEEXT)
FUZZ_CLI = fuzz/cli-fuzz$(EXEEXT)
FUZZ_DATE = fuzz/date-fuzz$(EXEEXT)
FUZZ_MBOX = fuzz/mbox-fuzz$(EXEEXT)
FUZZ_PATTERN = fuzz/pattern-fuzz$(EXEEXT)

.PHONY: fuzz
fuzz:	$(FUZZ_ADDRESS) $(FUZZ_BODY) $(FUZZ_CLI) $(FUZZ_DATE) $(FUZZ_MBOX) \
	$(FUZZ_PATTERN)

$(FUZZ_ADDRESS): fuzz/address.o $(NEOMUTTOBJS) $(LIBCOMMANDS) \
		$(LIBHOOKS) $(MUTTLIBS) $(NEOMUTTLIBS)
	$(CXX) $(CXXFLAGS) -o $@ fuzz/address.o $(NEOMUTTOBJS) \
		$(LIBCOMMANDS) $(LIBHOOKS) $(MUTTLIBS) $(LIBCOMMANDS) \
		$(LIBPARSE) $(LIBCONFIG) $(NEOMUTTLIBS) $(LDFLAGS) $(LIBS) \
		$(LIB_FUZZING_ENGINE)

$(FUZZ_BODY): fuzz/body.o $(NEOMUTTOBJS) $(LIBCOMMANDS) $(LIBHOOKS) \
		$(MUTTLIBS) $(NEOMUTTLIBS)
	$(CXX) $(CXXFLAGS) -o $@ fuzz/body.o $(NEOMUTTOBJS) \
		$(LIBCOMMANDS) $(LIBHOOKS) $(MUTTLIBS) $(LIBCOMMANDS) \
		$(LIBPARSE) $(LIBCONFIG) $(NEOMUTTLIBS) $(LDFLAGS) $(LIBS) \
		$(LIB_FUZZING_ENGINE)

$(FUZZ_CLI): fuzz/cli.o $(NEOMUTTOBJS) $(LIBCOMMANDS) $(LIBHOOKS) \
		$(MUTTLIBS) $(NEOMUTTLIBS)
	$(CXX) $(CXXFLAGS) -o $@ fuzz/cli.o $(NEOMUTTOBJS) \
		$(LIBCOMMANDS) $(LIBHOOKS) $(MUTTLIBS) $(LIBCOMMANDS) \
		$(LIBPARSE) $(LIBCONFIG) $(NEOMUTTLIBS) $(LDFLAGS) $(LIBS) \
		$(LIB_FUZZING_ENGINE)

$(FUZZ_DATE): fuzz/date.o $(NEOMUTTOBJS) $(LIBCOMMANDS) $(LIBHOOKS) \
		$(MUTTLIBS) $(NEOMUTTLIBS)
	$(CXX) $(CXXFLAGS) -o $@ fuzz/date.o $(NEOMUTTOBJS) \
		$(LIBCOMMANDS) $(LIBHOOKS) $(MUTTLIBS) $(LIBCOMMANDS) \
		$(LIBPARSE) $(LIBCONFIG) $(NEOMUTTLIBS) $(LDFLAGS) $(LIBS) \
		$(LIB_FUZZING_ENGINE)

$(FUZZ_MBOX): fuzz/mbox.o $(NEOMUTTOBJS) $(LIBCOMMANDS) $(LIBHOOKS) \
		$(MUTTLIBS) $(NEOMUTTLIBS)
	$(CXX) $(CXXFLAGS) -o $@ fuzz/mbox.o $(NEOMUTTOBJS) \
		$(LIBCOMMANDS) $(LIBHOOKS) $(MUTTLIBS) $(LIBCOMMANDS) \
		$(LIBPARSE) $(LIBCONFIG) $(NEOMUTTLIBS) $(LDFLAGS) $(LIBS) \
		$(LIB_FUZZING_ENGINE)

$(FUZZ_PATTERN): fuzz/pattern.o $(NEOMUTTOBJS) $(LIBCOMMANDS) $(LIBHOOKS) \
		$(MUTTLIBS) $(NEOMUTTLIBS)
	$(CXX) $(CXXFLAGS) -o $@ fuzz/pattern.o $(NEOMUTTOBJS) \
		$(LIBCOMMANDS) $(LIBHOOKS) $(MUTTLIBS) $(LIBCOMMANDS) \
		$(LIBPARSE) $(LIBCONFIG) $(NEOMUTTLIBS) $(LDFLAGS) $(LIBS) \
		$(LIB_FUZZING_ENGINE)

all-fuzz: $(FUZZ_ADDRESS) $(FUZZ_BODY) $(FUZZ_CLI) $(FUZZ_DATE) $(FUZZ_MBOX) \
	  $(FUZZ_PATTERN)

clean-fuzz:
	$(RM) $(FUZZ_ADDRESS) $(FUZZ_BODY) $(FUZZ_CLI) $(FUZZ_DATE) \
		$(FUZZ_MBOX) $(FUZZ_PATTERN) \
		$(FUZZ_OBJS) $(FUZZ_OBJS:.o=.Po)

install-fuzz:
uninstall-fuzz:

FUZZ_DEPFILES = $(FUZZ_OBJS:.o=.Po)
-include $(FUZZ_DEPFILES)

# vim: set ts=8 noexpandtab:
